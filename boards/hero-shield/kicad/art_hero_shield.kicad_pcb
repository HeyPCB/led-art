			(layer "B.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "B.Mask"
				(type "Bottom Solder Mask")
				(color "Blue")
				(thickness 0.01)
			)
			(layer "B.Paste"
				(type "Bottom Solder Paste")
