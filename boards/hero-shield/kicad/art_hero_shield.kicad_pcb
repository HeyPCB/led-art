				(material "FR4")
				(epsilon_r 4.5)
				(loss_tangent 0.02)
			)
			(layer "In1.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 2"
				(type "prepreg")
				(thickness 0.48)
				(material "FR4")
				(epsilon_r 4.5)
